<!--
  P01.8 — Événements Docker lus par docker-listener (wodle, rôle sentinel_agent).
  Stack de production : projet Compose fortyk (fortyk-caddy, fortyk-db, fortyk-api,
  fortyk-cloudflared, fortyk-scraper). Sentinelle lit le démon, ne le configure pas (HQ).
  Images connues (phase 1, liste écrite) : dernier segment exact =
    caddy · postgres · postgis · cloudflared · scraper · wazuh · fortyk.
  Hors portée du flux docker events (pas d'attribut privileged / mounts / ports) :
    conteneur privileged, socket docker.sock monté, port publié sur 0.0.0.0 :
    voir DISCOVERY.md et TASKS#P01.17 (sonde d'inspection).
-->
<group name="docker,sentinel,">

  <!--
    Attrape un docker exec (exec_start) dans un conteneur de production fortyk (hors scraper).
    Un dépannage du PO via docker exec est fréquent et peut déclencher à tort — c'est voulu (orange, à agréger).
  -->
  <rule id="100304" level="8">
    <if_sid>87901</if_sid>
    <field name="docker.Action">exec_start</field>
    <field name="docker.Actor.Attributes.name" type="pcre2">^fortyk-(caddy|db|api|cloudflared)-</field>
    <description>Docker (orange) : docker exec dans un conteneur de production</description>
  </rule>

  <!--
    Attrape le démarrage d'un conteneur dont le dernier segment d'image n'est pas dans la liste connue.
    Un déploiement qui tire une image nouvelle (tag ou dépôt) peut déclencher à tort — exclusion compose fortyk ci-dessous.
  -->
  <rule id="100305" level="8">
    <if_sid>87903</if_sid>
    <field name="docker.from" type="pcre2">^(?!(?:[^/]+/)*(?:caddy|postgres|postgis|cloudflared|scraper|wazuh|fortyk)(?::[^/\s]*)?$)</field>
    <description>Docker (orange) : image inconnue démarrée</description>
  </rule>

  <!--
    Exclusion : fenêtre horaire de la sauvegarde offsite quotidienne.
    Motif : sauvegarde de 03:30 — exec et redémarrages de conteneurs attendus pendant la fenêtre.
  -->
  <rule id="100352" level="0">
    <if_sid>100304,100305</if_sid>
    <time>3:00 am - 4:00 am</time>
    <description>Exclusion : fenêtre sauvegarde offsite de 03:30</description>
  </rule>

  <!--
    Exclusion : mirror-sync nocturne sur patator-standby.
    Motif : le standby restaure la stack fortyk chaque nuit — démarrages d'images attendus.
  -->
  <rule id="100353" level="0">
    <if_sid>100305</if_sid>
    <hostname>patator-standby</hostname>
    <time>1:00 am - 5:00 am</time>
    <description>Exclusion : mirror-sync nocturne du standby</description>
  </rule>

  <!--
    Exclusion : activité normale du conteneur ingest scraper.
    Motif : l'ingest recrée parfois des exec ou redémarre avec une image tag local — bruit métier attendu.
  -->
  <rule id="100354" level="0">
    <if_sid>100304,100305</if_sid>
    <field name="docker.Actor.Attributes.name" type="pcre2">^fortyk-scraper-</field>
    <description>Exclusion : activité normale du conteneur ingest scraper</description>
  </rule>

  <!--
    Exclusion : image nouvelle lors d'un docker compose up du projet fortyk.
    Motif : déploiement git pull + docker compose up tire parfois une image tag mise à jour.
  -->
  <rule id="100356" level="0">
    <if_sid>100305</if_sid>
    <field name="docker.Actor.Attributes.com.docker.compose.project">^fortyk$</field>
    <description>Exclusion : image nouvelle lors d'un docker compose up (déploiement git pull)</description>
  </rule>

</group>
