# =============================================================================
# 40KT1_SENTINEL — modèle de configuration
# =============================================================================
#
# Copier en `.env` sur la machine concernée. Le `.env` n'est JAMAIS committé
# (voir .gitignore) et ne quitte jamais la machine.
#
# Ce fichier ne porte AUCUNE valeur — seulement les noms, ce qu'ils veulent
# dire, et ce qui casse quand ils manquent.
#
# ⚠️ Trois de ces variables sont des secrets. `SENTINEL_ENROLL_KEY` en
# particulier permet d'inscrire un faux agent sur le serveur central : la
# traiter comme une clé privée, pas comme un identifiant.

# -----------------------------------------------------------------------------
# Identité du nœud
# -----------------------------------------------------------------------------
# Nom du nœud tel que le serveur central le connaîtra. Doit correspondre à
# l'inventaire : c'est lui qui apparaît dans les alertes, à 3 h du matin.
SENTINEL_NODE_NAME=

# Rôle du nœud dans le parc : primary | secondary | workstation
SENTINEL_NODE_ROLE=

# -----------------------------------------------------------------------------
# Serveur central
# -----------------------------------------------------------------------------
# Nom MagicDNS du serveur central sur le tailnet. JAMAIS une adresse publique :
# le serveur central n'est joignable que par le tailnet (RULES § 4).
SENTINEL_SERVER_HOST=

# Port d'enrôlement / port de collecte. Écoutés sur `tailscale0` uniquement.
SENTINEL_SERVER_ENROLL_PORT=1515
SENTINEL_SERVER_EVENT_PORT=1514

# SECRET — clé d'enrôlement présentée par l'agent au premier contact.
# Une fois l'agent enrôlé, elle peut être retirée du `.env` du nœud.
SENTINEL_ENROLL_KEY=

# SECRET — jeton d'API du serveur central, utilisé par les outils de lecture.
# À poser UNIQUEMENT sur l'hôte du serveur central et sur les postes ops.
SENTINEL_API_TOKEN=

# -----------------------------------------------------------------------------
# Alerte — réutilise le mécanisme de 40KT1_HQ (scripts/notify.sh)
# -----------------------------------------------------------------------------
# SECRET — webhook du salon Discord DÉDIÉ à la sécurité (#securite).
# Distinct de INFRA_DISCORD_WEBHOOK_URL de HQ : même mécanisme, deux
# destinations. Sans lui, aucune alerte ne part — et rien ne le dira.
SENTINEL_DISCORD_WEBHOOK_URL=

# Sujets ntfy pour le push mobile, séparés par des virgules. Sujet NON devinable.
# Un coéquipier d'astreinte s'ajoute ici, sans toucher au code.
SENTINEL_PUSH_URLS=

# -----------------------------------------------------------------------------
# Réponse automatique — TOUT est désarmé par défaut (RULES § 1)
# -----------------------------------------------------------------------------
# Armement global. `false` = l'exécuteur journalise et n'agit pas.
# Le passer à `true` est un geste d'exploitation décrit par un runbook,
# JAMAIS un effet de bord d'un apply.
SENTINEL_RESPONSE_ENABLED=false

# Mode à blanc : l'exécuteur journalise ce qu'il AURAIT fait, sans agir.
# C'est l'état de la phase P3 avant armement.
SENTINEL_RESPONSE_DRY_RUN=true

# Budget de remédiation : nombre de gestes automatiques par heure glissante.
# Le dernier déclenche un rouge ; au-delà, le dispositif cesse d'agir jusqu'à
# intervention humaine. Aligné sur ADR-062 de HQ. Le modifier est une décision
# d'ADR, pas un réglage.
SENTINEL_RESPONSE_BUDGET_PER_HOUR=3

# Témoin de désarmement d'urgence. Si ce fichier existe, AUCUN geste ne
# s'exécute — c'est le chemin hors bande, celui qui ne demande que SSH.
SENTINEL_DISARM_FILE=security-state/response-disarmed

# -----------------------------------------------------------------------------
# Mode tournoi — appartient à 40KT1_HQ, lu seulement (RULES § 3)
# -----------------------------------------------------------------------------
# Chemin du fichier témoin posé par le PO avant un event. Sentinelle le LIT ;
# elle ne le pose ni ne le retire. Deux automates qui se posent le même verrou
# est un mode de panne connu.
SENTINEL_TOURNAMENT_MODE_FILE=/srv/40kt1/node-state/tournament-mode
