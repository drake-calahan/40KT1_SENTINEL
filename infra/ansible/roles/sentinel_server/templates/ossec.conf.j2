{#
  Configuration du serveur central — 40KT1_SENTINEL, rôle `sentinel_server`.

  PROFIL FRUGAL (ADR-001) : manager seul. Pas d'indexeur, pas de console.
  PHASE 1 (A2, D5)        : OBSERVATION SEULE. Aucune alerte poussée, aucune
                            réponse active. On mesure le bruit de fond.

  Ce qui n'est PAS ici, et pourquoi :
    - <active-response> : le catalogue est fermé et l'exécuteur n'est pas
      câblé. ADR-002 § 6 pose cinq portes avant le premier geste. Un bloc de
      réponse posé « pour plus tard » est un dispositif armé qui s'ignore.
    - <integration> Discord/ntfy : le câblage d'alerte est le lot P02.0, et sa
      première exigence est la PREUVE D'ARRIVÉE sur le téléphone. Poser
      l'intégration avant la preuve, c'est croire qu'une alerte part.
    - <indexer> / <cluster> : profil frugal, et un seul nœud.
#}
<!--
  ATTENTION — FICHIER GÉRÉ PAR ANSIBLE (40KT1_SENTINEL, rôle sentinel_server).
  Toute modification faite ici sera écrasée au prochain passage du rôle.
  Modifier plutôt :
    infra/ansible/roles/sentinel_server/templates/ossec.conf.j2

  Hôte    : {{ inventory_hostname }}
  Profil  : {{ sentinel_server_profil | default('frugal') }} — manager seul
  Version : {{ sentinel_server_wazuh_version }} (épinglée)
  Phase   : 1 — observation seule, aucune réponse
-->
<ossec_config>

  <global>
    <!-- Aucun courriel. Le canal d'alerte du parc est notify.sh (Discord +
         ntfy), câblé en P02.0 après preuve d'arrivée sur le téléphone. -->
    <email_notification>no</email_notification>
    <!-- Les journaux de sécurité décrivent l'infrastructure entière : chemins,
         comptes, horaires, empreintes. On les garde, compressés, sur place
         (G1 : 90 jours en ligne, 12 mois d'archive) et on ne les exporte pas
         en clair (RULES § 4). -->
    <logall>no</logall>
    <logall_json>yes</logall_json>
  </global>

  <!-- ══ ÉCOUTE — condition 3 d'ADR-003 (C4) ═══════════════════════════════
       Le serveur central n'est joignable QUE par le tailnet. `local_ip` est
       résolue sur la machine à partir des faits : la figer dans le dépôt
       reviendrait à graver une IP de tailnet qui changera.
       Jamais 0.0.0.0 — qui couvrirait le LAN. Jamais Funnel, jamais
       cloudflared, jamais le nom public.
       Vérifié à l'armement par `ss -lntp`, pas seulement déclaré ici. -->
  <remote>
    <connection>secure</connection>
    <port>{{ sentinel_server_port_evenements }}</port>
    <protocol>tcp</protocol>
    <local_ip>{{ sentinel_server_listen_ip }}</local_ip>
  </remote>

  <!-- ══ ENRÔLEMENT ════════════════════════════════════════════════════════
       Par mot de passe, obligatoire. `SENTINEL_ENROLL_KEY` permet d'inscrire un
       FAUX AGENT sur le serveur central : c'est une clé privée, pas un
       identifiant. Elle vient du .env de la machine, jamais du dépôt.

       `force` désactivé : un agent déjà enrôlé n'est pas remplacé
       silencieusement par un nouveau qui prétendrait le même nom. -->
  <auth>
    <!-- FERMÉ PAR DÉFAUT, et ce n'est pas de la prudence décorative : mesuré en
         répétition à blanc (P01.21), wazuh-authd écoute sur **0.0.0.0** et non
         sur l'adresse du tailnet. Wazuh n'offre aucune option pour lier ce
         démon à une interface : la balise d'enrôlement n'a pas d'équivalent du
         local_ip de la balise remote. Laisser l'enrôlement ouvert exposerait
         donc le port d'inscription — et le secret qui le protège — au LAN, ce
         que C4 interdit. Le contrôle d'écoute de 20_armement.yml le refuse, à
         juste titre.

         L'enrôlement est donc une FENÊTRE, ouverte par un humain le temps
         d'inscrire les agents, puis refermée :
           -e '{"sentinel_server_authd_ouvert": true}'
         Voir docs/runbooks/mise-en-service.md § 2.

         ⚠️ NE JAMAIS ÉCRIRE LA BALISE OUVRANTE OU FERMANTE D'ENRÔLEMENT DANS UN
         COMMENTAIRE DE CE FICHIER. `wazuh-control` cherche ces balises par un
         `grep -n` pour savoir s'il doit démarrer le démon ; une occurrence de
         plus lui donne deux numéros de ligne, son `sed` échoue, il attend
         60 s puis déclare « wazuh-authd did not start correctly » — et
         L'UNITÉ ENTIÈRE échoue à démarrer. Mesuré 4.14.7, DISCOVERY.md. -->
    <disabled>{{ 'no' if sentinel_server_authd_ouvert | bool else 'yes' }}</disabled>
    <port>{{ sentinel_server_port_enrolement }}</port>
    <use_source_ip>no</use_source_ip>
    <purge>no</purge>
    <use_password>yes</use_password>
    <ssl_verify_host>no</ssl_verify_host>
    <ssl_auto_negotiate>no</ssl_auto_negotiate>
    <force>
      <enabled>no</enabled>
    </force>
  </auth>

  <!-- ══ AUTO-SURVEILLANCE DU NŒUD (agent local 000) ═══════════════════════
       Cet hôte porte le serveur central, donc il NE PORTE PAS d'agent :
       `wazuh-agent` et `wazuh-manager` se déclarent en conflit au niveau du
       paquet (mesuré 4.14.7). Sans les blocs ci-dessous, le nœud qui héberge
       le moteur de sécurité serait le SEUL nœud non surveillé du parc — et
       c'est justement celui où vivent les preuves.

       Les listes viennent des mêmes variables `sentinel_fim_*` que l'agent
       (group_vars/all) : une seule liste, deux lecteurs. Une divergence entre
       les deux nœuds sur ce que « intégrité » veut dire serait invisible
       jusqu'au jour où elle compte. `P01.21`. -->
  <syscheck>
    <disabled>no</disabled>
    <frequency>{{ sentinel_server_fim_frequency_seconds }}</frequency>
    <scan_on_start>yes</scan_on_start>
{% for chemin in sentinel_fim_realtime_paths %}
    <directories realtime="yes" report_changes="yes">{{ chemin }}</directories>
{% endfor %}
{% for chemin in sentinel_fim_nodiff_paths | default([]) %}
    <nodiff>{{ chemin }}</nodiff>
{% endfor %}
  </syscheck>

  <!-- Journaux système — LECTURE seule, comme sur un agent. -->
  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/auth.log</location>
  </localfile>

  <localfile>
    <log_format>syslog</log_format>
    <location>/var/log/syslog</location>
  </localfile>

  <!-- auditd — sa configuration appartient à HQ ; on lit seulement. -->
  <localfile>
    <log_format>audit</log_format>
    <location>/var/log/audit/audit.log</location>
  </localfile>

  <!-- Docker — la stack appartient à HQ ; on lit le démon, on ne le configure
       pas. Ce nœud restaure la stack chaque nuit (mirror-sync) : les règles
       `100353` et suivantes portent l'exclusion horaire correspondante. -->
  <wodle name="docker-listener">
    <disabled>no</disabled>
    <interval>1m</interval>
    <attempts>5</attempts>
    <run_on_start>yes</run_on_start>
  </wodle>

  <!-- ══ JEU DE RÈGLES ═════════════════════════════════════════════════════
       CE BLOC N'EST PAS DÉCORATIF. Mesuré sur `wazuh-manager:4.14.7` : sans
       lui, le moteur charge quand même son jeu de base — mais PAS
       `etc/rules`, c'est-à-dire aucune règle Sentinelle. Un événement de perte
       de contact retombait alors sur la règle de base `504` au lieu de notre
       `100501`. Le serveur aurait tourné, journalisé, et n'aurait appliqué
       aucune des règles écrites par `P01.2`, `P01.8` et `P01.3` : le faux vert
       exact que `.agent/RULES.md` § 1 interdit, et le plus difficile à voir
       puisqu'il ne produit pas d'erreur, seulement du silence.

       Le bloc reprend le jeu par défaut de l'éditeur AVANT d'ajouter le nôtre :
       déclarer `etc/rules` seul remplacerait le défaut au lieu de l'étendre, et
       on perdrait les listes CDB. Sentinelle AJOUTE, elle ne réécrit pas — la
       même règle que pour HQ (`H3`). -->
  <ruleset>
    <!-- Jeu par défaut de l'éditeur — recopié tel quel. -->
    <decoder_dir>ruleset/decoders</decoder_dir>
    <rule_dir>ruleset/rules</rule_dir>
    <rule_exclude>0215-policy_rules.xml</rule_exclude>
    <list>etc/lists/audit-keys</list>
    <list>etc/lists/amazon/aws-eventnames</list>
    <list>etc/lists/security-eventchannel</list>
    <list>etc/lists/malicious-ioc/malware-hashes</list>
    <list>etc/lists/malicious-ioc/malicious-ip</list>
    <list>etc/lists/malicious-ioc/malicious-domains</list>

    <!-- Jeu Sentinelle — les fichiers `sentinel-*.xml` posés par le rôle
         depuis `rules/` du dépôt. Une règle éditée à la main ici disparaît au
         prochain passage : c'est voulu (`rules/README.md`). -->
    <decoder_dir>etc/decoders</decoder_dir>
    <rule_dir>etc/rules</rule_dir>
  </ruleset>

  <!-- ══ RÉTENTION (G1) ════════════════════════════════════════════════════
       90 jours en ligne, 12 mois d'archive compressée. Pas de recherche
       historique en phase 1 : c'est la dette assumée du profil frugal
       (ADR-001), et une investigation se fait en ligne de commande. -->
  <global>
    <rotate_interval>1d</rotate_interval>
    <max_output_size>50M</max_output_size>
  </global>

  <!-- ══ CE QUE LE SERVEUR NE FAIT PAS EN PHASE 1 ══════════════════════════
       Les modules d'inventaire et de conformité sont laissés à leur défaut ;
       les RAPPORTS hebdomadaires (D3 conformité, D4 vulnérabilités) sont le
       lot P01.9, en LECTURE SEULE, unités livrées désarmées.

       ⚠️ L'inventaire de vulnérabilités dépend du mineur retenu : voir
       roles/sentinel_server/README.md § « La question ouverte ». À trancher
       AVANT P01.9. -->

  <!-- Aucun bloc <active-response> : la réponse ne s'écrit pas ici. Le
       catalogue est fermé (ADR-002) et l'exécuteur décide LOCALEMENT, côté
       nœud (E7). Le transport se câble en P03.1, après les cinq portes. -->

</ossec_config>
